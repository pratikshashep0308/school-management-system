# Maharashtra State Board academic year — confirmed 14 August 2026
#
# Schools open around 15 June and close 30 April every year.
# Final results are announced on 1 May, grade-wide (decision D-010).
#
# Bash:        set -a; . ./config/academic-year-2026-27.env; set +a
# PowerShell:  see INSTALLATION-GUIDE.md section 6

TFS_ACADEMIC_YEAR_NAME=2026-27
TFS_ACADEMIC_YEAR_START=2026-06-15
TFS_ACADEMIC_YEAR_END=2027-04-30

# The 1 May result declaration falls one day AFTER the academic year ends.
# This is correct and needs no special handling: ExamGroup.academicYearId is an
# explicit reference rather than something derived from a date, and nothing
# validates resultsPublishedAt against the year boundary. The exam DATES
# (typically March-April) sit inside the year; only the publication timestamp
# is outside it.
#
# The 1 May to 14 June break belongs to NO academic year. Do not record it as a
# holiday: the importer rejects out-of-year dates, and calendarService blocks
# attendance marking in that window with reason 'outside-academic-year'.
